[Unit]
Description=Stock PM daily Alpaca market, valuation, earnings and review sync
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/stock-pm
ExecStart=/bin/sh -c '/usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.alpaca --mode daily && /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.fundamentals && /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.flow --days 1 && /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.macro && /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.cboe && /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.events.job; /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.review; /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm environment-job; /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.tape_job; /usr/bin/docker compose --env-file /opt/stock-pm/.env.server run --rm app python -m stock_pm.prediction_job'
