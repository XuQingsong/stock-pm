# PostgreSQL 连接串。生产环境请使用独立用户和强密码。
DATABASE_URL=postgresql://stock_pm:stock_pm_dev@localhost:5432/stock_pm
ALPACA_API_KEY_ID=your_alpaca_key_id
ALPACA_API_SECRET_KEY=your_alpaca_secret_key
ALPACA_DATA_FEED=iex
ALPACA_BARS_FEED=sip
ALPACA_OPTIONS_FEED=indicative
FRED_API_KEY=your_fred_api_key
# FRED also has a keyless official CSV fallback. The key improves API transport only.
FMP_API_KEY=your_fmp_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
# Phase 1.2 External Intelligence. Tavily/Exa are discovery providers, not publishers.
# Paste real keys locally. Benzinga is intentionally not wired (14-day trial).
TAVILY_API_KEY=your_tavily_api_key
EXA_API_KEY=your_exa_api_key
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# Production Brain layers. Names are env-driven; business code does not hardcode them.
# Mechanical = structured extraction only. Reasoning = all judgment, including independent critic.
# Credentials fall back to DASHSCOPE_API_KEY / STRONG_MODEL_API_KEY. DeepSeek is not a Brain default.
# Kimi is not in the production Brain workflow.
# Example (Alibaba Cloud Model Studio / Bailian compatible-mode):
# MECHANICAL_MODEL_PROVIDER=openai
# MECHANICAL_MODEL_NAME=glm-5.2
# MECHANICAL_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REASONING_MODEL_PROVIDER=openai
# REASONING_MODEL_NAME=glm-5.3
# REASONING_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MECHANICAL_MODEL_PROVIDER=openai
MECHANICAL_MODEL_NAME=GLM-5.2
MECHANICAL_MODEL_API_KEY=
MECHANICAL_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL_PROVIDER=openai
REASONING_MODEL_NAME=GLM-5.3
REASONING_MODEL_API_KEY=
REASONING_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Brain Capability Benchmark only. Does not replace the production LLM_*.
# Vendor-agnostic OpenAI-compatible gateway. Example (Alibaba Cloud Model Studio / Bailian):
# STRONG_MODEL_PROVIDER=openai
# STRONG_MODEL_API_KEY=sk-your-dashscope-key
# STRONG_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STRONG_MODEL_NAME=qwen3.8-max
# Optional extra names sharing STRONG_MODEL_* credentials, comma-separated.
# Bailian OpenAI-compatible IDs: qwen3.8-max, glm-5.3, kimi-k3.
# ZHIPU/GLM-5.3 is a separate third-party SKU and may not be activated.
# BENCHMARK_MODELS=qwen3.8-max,glm-5.3,kimi-k3
# DASHSCOPE_API_KEY is an alias used only if STRONG_MODEL_API_KEY is empty.
# Mainland compatible-mode: https://dashscope.aliyuncs.com/compatible-mode/v1
STRONG_MODEL_PROVIDER=
STRONG_MODEL_API_KEY=
STRONG_MODEL_BASE_URL=
STRONG_MODEL_NAME=
BENCHMARK_MODELS=
DASHSCOPE_API_KEY=
# Google Programmable Search is discovery-only. Missing keys stay not_configured.
# Never scrape Google HTML. Do not wait on this key for official event ingest.
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_google_cse_id
# empty/live = production default: real official feeds only.
# recorded_replay = labeled replay of recorded official originals (never production latest).
# demo|fixture for algorithm seed/tests only.
STOCK_PM_EVENTS_MODE=
# SEC EDGAR fair-access User-Agent. Format: Company Name contact@your-domain
# Leave empty to skip SEC Atom matching. Reserved/example hosts are rejected.
SEC_EDGAR_USER_AGENT=
# Max Alpha Vantage earnings HTTP calls per events discover. Cache + rotate; do not raise concurrency.
# Persist last_attempt_at in cache dir (earnings_coverage.json). reset_cache does not delete it.
# AV raw payloads use last-success cache and go stale after 120 days; they are also not deleted by jobs.
STOCK_PM_EARNINGS_BUDGET=8
